# --- 環境変数テンプレート ---
# このファイルを `.env` にコピーして使ってください。
# (.env はリポジトリに含めない / .gitignore で除外)

# GCP プロジェクト ID (gcloud config get-value project で取れる値)
GOOGLE_CLOUD_PROJECT=your-project-id

# デプロイ先リージョン (基本は us-central1 でOK)
GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI を ADK のバックエンドにする
GOOGLE_GENAI_USE_VERTEXAI=true
